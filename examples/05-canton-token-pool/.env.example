# ============================================================================
# Canton Wallet Gateway (CIP-103) — deploy / validate a token pool
# ============================================================================
#
# gatewayUrl + gatewayAccessToken authenticate against a Wallet Gateway
# instance (self-hosted or provided by a wallet). The access token is either
# a pre-obtained JWT (session or API key) — no browser OAuth flow needed here.

CANTON_GATEWAY_URL=https://your-wallet-gateway.example.com
CANTON_GATEWAY_ACCESS_TOKEN=

# Optional — defaults to the Wallet Gateway's primary party if unset.
# CANTON_POOL_OWNER=owner::1220...

# Network: canton:TestNet | canton:DevNet | canton:MainNet (default: canton:TestNet)
# CANTON_CHAIN_ID=canton:TestNet

# ============================================================================
# Token pool parameters
# ============================================================================

CANTON_INSTRUMENT_ID=MYTOKEN
CANTON_DECIMALS=10
# Comma-separated EDS observer parties — mandatory, the on-ledger `ensure`
# clause rejects an empty list.
CANTON_OBSERVERS=

# Optional — defaults to `<instrumentId>-pool-001`.
# CANTON_POOL_INSTANCE_ID=mytoken-pool-001

# burnMint | lockRelease (default: burnMint)
# CANTON_POOL_TYPE=burnMint

# ============================================================================
# Remote (EVM) lane wiring
# ============================================================================

CANTON_REMOTE_CHAIN_SELECTOR=16015286601757825753
CANTON_REMOTE_TOKEN_ADDRESS=0x...
CANTON_REMOTE_POOLS=0x...
# Comma-separated committee-verifier raw instance addresses.
CANTON_CCV=

# Rate-limiter capacity/rate, in human token units (scaled to CANTON_DECIMALS on-ledger).
# CANTON_RL_CAPACITY=1000000
# CANTON_RL_RATE=100

# apply-evm-chain-updates.ts only: set to "false" to wire the EVM-side rate
# limiters disabled (default: enabled). deploy-pool.ts always deploys its
# Canton-side rate limiters enabled.
# CANTON_RATE_LIMITS_ENABLED=true

# ============================================================================
# EVM side (apply-evm-chain-updates.ts) — wires the reverse lane on the EVM pool
# ============================================================================

EVM_PRIVATE_KEY=0x...
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_POOL_ADDRESS=0x...
# Optional overrides — otherwise derived from the Canton instrument/pool above.
# EVM_REMOTE_POOL_ADDRESS=0x...
# EVM_REMOTE_TOKEN_ADDRESS=0x...
