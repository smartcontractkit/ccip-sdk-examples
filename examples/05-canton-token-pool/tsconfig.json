{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The SDK is consumed via a `link:` to its source (its own tsconfig compiles
    // it with these settings), so mirror them here for typechecking the program.
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src/**/*"],
  // These utilities exercise SDK manager methods that are not yet published
  // (they exist only on an SDK feature branch) — excluded so the example
  // typechecks against the published @chainlink/ccip-sdk. They still run via
  // tsx against a linked SDK checkout that has the methods.
  "exclude": [
    "node_modules",
    "dist",
    "src/one-off-ops.ts",
    "src/cleanup-registry-pools.ts",
    "src/debug-acs-shape.ts",
    "src/debug-execute.ts",
    "src/debug-metadata.ts",
    "src/debug-pool-meta.ts",
    "src/debug-preapproval.ts",
    "src/debug-templateid-forms.ts"
  ]
}
